# OpenAI: backup for photo identification; independent provider for metadata reviews
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Claude: primary for photo identification; optional independent metadata reviews
# Create a workspace-scoped key in Claude Console
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only needed for a key that is not workspace-scoped
ANTHROPIC_WORKSPACE_ID=
